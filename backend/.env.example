# ==============================================================================
# Maryam Sparkle API - Environment Configuration (.env.example)
# ==============================================================================
# Copy this template to `.env` in the backend directory for local development.
# NEVER commit the actual `.env` file containing real credentials to version control.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
APP_DEBUG=true
APP_NAME="Maryam Sparkle API"
APP_TIMEZONE=Asia/Karachi

# Allowed Frontend Origins for CORS (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Credentials (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maryam_sparkle
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4
